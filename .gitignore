# Dependencies
node_modules/

# Secrets — never commit. Use config/credentials.example.json as the template.
config/credentials.json
config/tokens.json

# Defensive secret patterns — catch anything added later, before it's staged.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
**/secrets.json
*service-account*.json
*serviceaccount*.json
*credentials.json
!*credentials.example.json

# Generated content, working data, and the local sqlite db
data/
uploads/
temp/
graphify-out/

# Downloaded models (whisper.cpp etc.) — large binaries, re-downloadable
models/

# Logs
logs/
*.log

# Test/scratch artifacts — keep the scripts, drop the generated media
test-longform/**/*.mp4
test-longform/**/*.mp3
test-longform/**/*.png
test-longform/**/*.wav
test-longform/**/renders/

# OS cruft
.DS_Store
